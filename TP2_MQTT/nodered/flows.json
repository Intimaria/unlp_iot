[
    {
        "id": "tab-esp32-pipeline",
        "type": "tab",
        "label": "ESP32 Sensor Pipeline",
        "disabled": false,
        "info": "Receives MQTT messages from the ESP32 weather station and stores them in InfluxDB."
    },
    {
        "id": "mqtt-broker-mosquitto",
        "type": "mqtt-broker",
        "name": "Mosquitto",
        "broker": "mosquitto",
        "port": "1883",
        "clientid": "nodered-client",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true,
        "autoUnsubscribe": true,
        "birthTopic": "",
        "birthQos": "0",
        "birthRetain": "false",
        "birthPayload": "",
        "birthMsg": {},
        "closeTopic": "",
        "closeQos": "0",
        "closeRetain": "false",
        "closePayload": "",
        "closeMsg": {},
        "willTopic": "",
        "willQos": "0",
        "willRetain": "false",
        "willPayload": "",
        "willMsg": {},
        "userProps": "",
        "sessionExpiry": ""
    },
    {
        "id": "influxdb-config",
        "type": "influxdb",
        "hostname": "influxdb",
        "port": "8086",
        "protocol": "http",
        "database": "iot",
        "name": "InfluxDB IoT",
        "usetls": false,
        "tls": "",
        "influxdbVersion": "1.x",
        "url": "http://influxdb:8086",
        "rejectUnauthorized": false
    },
    {
        "id": "mqtt-in-sensor",
        "type": "mqtt in",
        "z": "tab-esp32-pipeline",
        "name": "sensor/ambiente",
        "topic": "sensor/ambiente",
        "qos": "0",
        "datatype": "auto-detect",
        "broker": "mqtt-broker-mosquitto",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 150,
        "y": 200,
        "wires": [["json-parse"]]
    },
    {
        "id": "json-parse",
        "type": "json",
        "z": "tab-esp32-pipeline",
        "name": "JSON",
        "property": "payload",
        "action": "",
        "pretty": false,
        "x": 350,
        "y": 200,
        "wires": [["function-transform"]]
    },
    {
        "id": "function-transform",
        "type": "function",
        "z": "tab-esp32-pipeline",
        "name": "Transform for InfluxDB",
        "func": "msg.measurement = \"ambiente\";\nmsg.payload = {\n    temperatura:  msg.payload.temp,\n    humedad:      msg.payload.hum,\n    calidad_aire: msg.payload.gas,\n    luz:          msg.payload.luz\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 560,
        "y": 200,
        "wires": [["influxdb-out"]]
    },
    {
        "id": "influxdb-out",
        "type": "influxdb out",
        "z": "tab-esp32-pipeline",
        "influxdb": "influxdb-config",
        "name": "InfluxDB IoT",
        "measurement": "",
        "precision": "",
        "retentionPolicy": "",
        "database": "iot",
        "precisionV18FluxV20": "ms",
        "retentionPolicyV18Flux": "",
        "org": "",
        "bucket": "",
        "x": 770,
        "y": 200,
        "wires": []
    }
]
