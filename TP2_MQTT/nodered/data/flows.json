[
    {
        "id": "tab-esp32-pipeline",
        "type": "tab",
        "label": "ESP32 Sensor Pipeline",
        "disabled": false,
        "info": "Receives MQTT messages from the ESP32 weather station and stores them in InfluxDB."
    },
    {
        "id": "tab-telegram-bot",
        "type": "tab",
        "label": "Telegram Bot",
        "disabled": false,
        "info": "Telegram bot for remote status."
    },
    {
        "id": "mqtt-broker-mosquitto",
        "type": "mqtt-broker",
        "name": "Mosquitto",
        "broker": "mosquitto",
        "port": "1883",
        "clientid": "nodered-client",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true,
        "autoUnsubscribe": true,
        "birthTopic": "",
        "birthQos": "0",
        "birthRetain": "false",
        "birthPayload": "",
        "birthMsg": {},
        "closeTopic": "",
        "closeQos": "0",
        "closeRetain": "false",
        "closePayload": "",
        "closeMsg": {},
        "willTopic": "",
        "willQos": "0",
        "willRetain": "false",
        "willPayload": "",
        "willMsg": {},
        "userProps": "",
        "sessionExpiry": ""
    },
    {
        "id": "influxdb-config",
        "type": "influxdb",
        "hostname": "influxdb",
        "port": "8086",
        "protocol": "http",
        "database": "iot",
        "name": "InfluxDB IoT",
        "usetls": false,
        "tls": "",
        "influxdbVersion": "1.x",
        "url": "http://influxdb:8086",
        "rejectUnauthorized": false
    },
    {
        "id": "telegram-bot-config",
        "type": "telegram bot",
        "botname": "tiempo_iot_bot",
        "usernames": "in7u1",
        "chatids": "",
        "baseapiurl": "",
        "testenvironment": false,
        "updatemode": "polling",
        "pollinterval": "300",
        "usesocks": false,
        "sockshost": "",
        "socksport": "6667",
        "socksusername": "anonymous",
        "sockspassword": "",
        "bothost": "",
        "botpath": "",
        "localbothost": "",
        "localbotport": "8443",
        "publicbotport": "8443",
        "privatekey": "",
        "certificate": "",
        "useselfsignedcertificate": false,
        "sslterminated": false,
        "verboselogging": true
    },
    {
        "id": "mqtt-in-sensor",
        "type": "mqtt in",
        "z": "tab-esp32-pipeline",
        "name": "sensor/ambiente",
        "topic": "sensor/ambiente",
        "qos": "0",
        "datatype": "auto-detect",
        "broker": "mqtt-broker-mosquitto",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 150,
        "y": 200,
        "wires": [
            [
                "json-parse"
            ]
        ]
    },
    {
        "id": "json-parse",
        "type": "json",
        "z": "tab-esp32-pipeline",
        "name": "JSON",
        "property": "payload",
        "action": "obj",
        "pretty": false,
        "x": 350,
        "y": 200,
        "wires": [
            [
                "function-transform"
            ]
        ]
    },
    {
        "id": "function-transform",
        "type": "function",
        "z": "tab-esp32-pipeline",
        "name": "Transform for InfluxDB",
        "func": "msg.measurement = \"ambiente\";\nmsg.payload = {\n    temperatura: msg.payload.temp,\n    humedad: msg.payload.hum,\n    co2: msg.payload.co2,\n    co: msg.payload.co,\n    alcohol: msg.payload.alcohol,\n    nh4: msg.payload.nh4,\n    tolueno: msg.payload.tolueno,\n    luz: msg.payload.luz\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 560,
        "y": 200,
        "wires": [
            [
                "influxdb-out"
            ]
        ]
    },
    {
        "id": "influxdb-out",
        "type": "influxdb out",
        "z": "tab-esp32-pipeline",
        "influxdb": "influxdb-config",
        "name": "InfluxDB IoT",
        "measurement": "",
        "precision": "",
        "retentionPolicy": "",
        "database": "iot",
        "precisionV18FluxV20": "ms",
        "retentionPolicyV18Flux": "",
        "org": "",
        "bucket": "",
        "x": 770,
        "y": 200,
        "wires": []
    },
    {
        "id": "mqtt-in-telegram-cache",
        "type": "mqtt in",
        "z": "tab-telegram-bot",
        "name": "Cache Sensor Data",
        "topic": "sensor/ambiente",
        "qos": "0",
        "datatype": "json",
        "broker": "mqtt-broker-mosquitto",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 170,
        "y": 100,
        "wires": [
            [
                "function-cache-data"
            ]
        ]
    },
    {
        "id": "function-cache-data",
        "type": "function",
        "z": "tab-telegram-bot",
        "name": "Save to Flow",
        "func": "flow.set('lastReading', msg.payload);\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 100,
        "wires": [
            []
        ]
    },
    {
        "id": "telegram-receiver",
        "type": "telegram receiver",
        "z": "tab-telegram-bot",
        "name": "Receive Commands",
        "bot": "telegram-bot-config",
        "saveDataDir": "",
        "filterCommands": false,
        "hasinput": false,
        "inputs": 0,
        "handleallupdates": false,
        "handleprocessupdates": false,
        "x": 170,
        "y": 220,
        "wires": [
            [
                "switch-command"
            ],
            []
        ]
    },
    {
        "id": "switch-command",
        "type": "switch",
        "z": "tab-telegram-bot",
        "name": "Check /status",
        "property": "payload.content",
        "propertyType": "msg",
        "rules": [
            {
                "t": "eq",
                "v": "/status",
                "vt": "str"
            }
        ],
        "checkall": "true",
        "repair": false,
        "outputs": 1,
        "x": 380,
        "y": 220,
        "wires": [
            [
                "function-build-reply"
            ]
        ]
    },
    {
        "id": "function-build-reply",
        "type": "function",
        "z": "tab-telegram-bot",
        "name": "Build Reply",
        "func": "var data = flow.get('lastReading');\n\nif (!data) {\n    msg.payload.content = \"No data received yet from the station.\";\n} else {\n    msg.payload.content = \"🌡️ *Environment Status*\\n\" +\n        \"Temperature: \" + data.temp + \" °C\\n\" +\n        \"Humidity: \" + data.hum + \" %\\n\" +\n        \"CO2: \" + data.co2 + \" ppm\\n\" +\n        \"CO: \" + data.co + \" ppm\\n\" +\n        \"Light Level: \" + data.luz;\n}\n\nmsg.payload.type = 'message';\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 570,
        "y": 220,
        "wires": [
            [
                "telegram-sender"
            ]
        ]
    },
    {
        "id": "telegram-sender",
        "type": "telegram sender",
        "z": "tab-telegram-bot",
        "name": "Send Reply",
        "bot": "telegram-bot-config",
        "haserroroutput": false,
        "outputs": 1,
        "x": 770,
        "y": 220,
        "wires": [
            []
        ]
    }
]