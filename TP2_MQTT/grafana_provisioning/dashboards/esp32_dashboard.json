        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb_iot"
      },
      "targets": [
        {
          "refId": "A",
          "query": "SELECT mean(\"temperatura\") FROM \"ambiente\" WHERE $timeFilter GROUP BY time($__interval) fill(previous)",
          "rawQuery": true,
          "alias": "Temperatura (°C)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2,
            "gradientMode": "opacity"
          }
        }
