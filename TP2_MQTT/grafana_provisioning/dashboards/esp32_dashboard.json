{
  "title": "ESP32 Weather Station — InfluxDB Historics",
  "tags": [
    "esp32",
    "iot",
    "influxdb",
    "mqtt"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "schemaVersion": 36,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Temperatura Actual",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb_iot"
      },
      "targets": [
        {
          "refId": "A",
          "query": "SELECT last(\"temperatura\") FROM \"ambiente\" WHERE $timeFilter",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "red",
                "value": 40
              }
            ]
          }
        }
      }
    },
